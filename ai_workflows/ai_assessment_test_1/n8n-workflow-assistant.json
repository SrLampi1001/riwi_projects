{
  "name": "AI Assistant with Gemini RAG and Human Handoff",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chat",
        "responseMode": "lastNode"
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {},
      "name": "Email Trigger (IMAP)",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 1,
      "position": [
        0,
        400
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "userInput",
              "value": "={{ $json.body?.message || $json.message?.text || $json.textPlain || '' }}"
            },
            {
              "name": "source",
              "value": "={{ $node['Webhook Trigger'] ? 'webhook' : ($node['Telegram Trigger'] ? 'telegram' : 'email') }}"
            },
            {
              "name": "replyTo",
              "value": "={{ $json.message?.chat?.id || $json.from?.address || '' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        200,
        200
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.userInput }}",
        "options": {
          "systemMessage": "You are a helpful assistant for Foreign Languages Academy Made in Colombia. Use the provided 'Vector Store Tool' to find information in the uploaded context file before answering. Answer questions about schedules, prices, levels, inscriptions, certifications, and modalities in English and Spanish.\n\nIMPORTANT INSTRUCTION: If the user refers to something that is not in the context or requires human intervention (e.g. complaints, or questions you cannot answer using the Vector Store Tool), respond EXACTLY with the string: [HANDOFF_REQUIRED]. Otherwise, answer normally based only on the context found."
        }
      },
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "model": "gemini-pro",
        "options": {}
      },
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        500,
        450
      ]
    },
    {
      "parameters": {
        "sessionId": "={{ $json.replyTo }}"
      },
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1,
      "position": [
        650,
        450
      ]
    },
    {
      "parameters": {
        "name": "Vector Store Tool",
        "description": "Use this tool to find information about academy schedules, prices, levels, inscriptions, certifications, and modalities."
      },
      "name": "Vector Store Tool",
      "type": "@n8n/n8n-nodes-langchain.toolVectorStore",
      "typeVersion": 1,
      "position": [
        800,
        450
      ]
    },
    {
      "parameters": {},
      "name": "In-Memory Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1,
      "position": [
        800,
        650
      ]
    },
    {
      "parameters": {
        "fileSelector": "/data/rag/rag_context.txt"
      },
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [
        700,
        850
      ]
    },
    {
      "parameters": {
        "model": "models/embedding-001"
      },
      "name": "Embeddings Google Gemini",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        900,
        850
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.output }}",
              "operation": "contains",
              "value2": "[HANDOFF_REQUIRED]"
            }
          ]
        }
      },
      "name": "Check Handoff",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1000,
        200
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "messageToUser",
              "value": "I don't have that information. Please contact the academy directly."
            }
          ]
        },
        "options": {}
      },
      "name": "Set Handoff Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1200,
        100
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.HUMAN_SUPPORT_CHAT_ID }}",
        "text": "=User requested help. Source: {{ $json.source }}\nReply info: {{ $json.replyTo }}\nOriginal Query: {{ $item(0).$node['Normalize Input'].json.userInput }}"
      },
      "name": "Telegram Handoff Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1400,
        50
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.HUMAN_SUPPORT_EMAIL }}",
        "toEmail": "={{ $env.HUMAN_SUPPORT_EMAIL }}",
        "subject": "Human Handoff Required",
        "text": "=User requested help. Source: {{ $json.source }}\nReply info: {{ $json.replyTo }}\nOriginal Query: {{ $item(0).$node['Normalize Input'].json.userInput }}"
      },
      "name": "Email Handoff Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1400,
        150
      ]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "messageToUser",
              "value": "={{ $json.output }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Respond to User",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Trigger (IMAP)": {
      "main": [
        [
          {
            "node": "Normalize Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Input": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Check Handoff",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Vector Store Tool": {
      "ai_tool": [
        [
          {
            "node": "AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "In-Memory Vector Store": {
      "ai_vectorStore": [
        [
          {
            "node": "Vector Store Tool",
            "type": "ai_vectorStore",
            "index": 0
          }
        ]
      ]
    },
    "Default Data Loader": {
      "ai_document": [
        [
          {
            "node": "In-Memory Vector Store",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings Google Gemini": {
      "ai_embedding": [
        [
          {
            "node": "In-Memory Vector Store",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Check Handoff": {
      "main": [
        [
          {
            "node": "Set Handoff Message",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond to User",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Handoff Message": {
      "main": [
        [
          {
            "node": "Telegram Handoff Alert",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email Handoff Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}