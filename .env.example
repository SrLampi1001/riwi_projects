# --- Database ---
POSTGRES_USER=bioma_owner
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=bioma_local
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Connection string used by the application (psycopg) and by the seed/migrate scripts.
# The application role is created with limited privileges; passwords are placeholders.
DATABASE_URL=postgresql://bioma_app:change_me_local@db:5432/bioma_local

# --- AI providers (used by the backend in later PRs; placeholders for now) ---
# Mistral — embeddings (`mistral-embed`, 1024 dims). Free "Experiment" tier.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_EMBED_MODEL=mistral-embed

# NVIDIA NIM — chat (OpenAI-compatible). Free tier.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_CHAT_MODEL=meta/llama-3.3-70b-instruct

# --- Auth (used by the backend in a later PR) ---
JWT_SECRET=change_me_jwt_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
