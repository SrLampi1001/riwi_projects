# --- Database ---
# The superuser that docker compose uses to bootstrap the database.
# 0001_init.sql creates the application roles (bioma_owner, bioma_app) with
# their own passwords, so this user is only used by the migrate container.
POSTGRES_USER=bioma_superuser
POSTGRES_PASSWORD=change_me_superuser
POSTGRES_DB=bioma_local

# Host the application connects to from outside docker (laptop, etc.).
POSTGRES_HOST=localhost
# Host the application connects to from inside docker (service name on the
# compose network). Compose files default this to the service name "db".
POSTGRES_HOST_INTERNAL=db
POSTGRES_PORT=5432

# Connection string used by the application (psycopg) and by the seed/migrate
# scripts. The migrate container uses the superuser; the seed container uses
# bioma_owner (BYPASSRLS) so it can bypass RLS for the load.
DATABASE_URL=postgresql://bioma_app:change_me_app@localhost:5432/bioma_local
SEED_DB_USER=bioma_owner
SEED_DB_PASSWORD=change_me_owner

# --- AI providers (used by the backend in later PRs; placeholders for now) ---
# Mistral — embeddings (`mistral-embed`, 1024 dims). Free "Experiment" tier.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_EMBED_MODEL=mistral-embed

# NVIDIA NIM — chat (OpenAI-compatible). Free tier.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_CHAT_MODEL=meta/llama-3.3-70b-instruct

# --- Auth (used by the backend in a later PR) ---
JWT_SECRET=change_me_jwt_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
