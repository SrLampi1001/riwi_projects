# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL credentials (used for n8n database)
POSTGRES_DB=n8n
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=change_this_secure_password

# User verification database credentials (for admin panel and user forms - deferred)
USER_DB_DB=users
USER_DB_USER=users_user
USER_DB_PASSWORD=change_this_secure_password_users

# ===========================================
# N8N CONFIGURATION
# ===========================================
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_this_admin_password
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678
# Encryption key for credential storage (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=change_this_to_a_random_32_character_hex_string

# ===========================================
# REDIS (CACHING)
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# GOOGLE GEMINI API (Free tier available)
# ===========================================
# Get your API key at: https://aistudio.google.com/app/apikey
# Free tier includes: 1,500 requests/day, 15 requests/minute
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ===========================================
# HUMAN SUPPORT (Handoff when AI can't answer)
# ===========================================
# Telegram chat ID for admin notifications (get via @userinfobot)
HUMAN_SUPPORT_CHAT_ID=your_telegram_chat_id_here

# Email for admin notifications
HUMAN_SUPPORT_EMAIL=admin@academia.com

# ===========================================
# FALLBACK: OpenAI API (optional, if Gemini fails)
# ===========================================
# Only needed if you configure a fallback in the AI workflow
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# TELEGRAM BOT
# ===========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# ===========================================
# EMAIL (SMTP) - For sending emails
# ===========================================
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com

# ===========================================
# EMAIL (IMAP) - For receiving emails as triggers
# ===========================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_app_password

# ===========================================
# RAG CONFIGURATION
# ===========================================
RAG_CONTEXT_PATH=/data/rag/rag_context.txt

# ===========================================
# CACHING STRATEGY
# ===========================================
# Options: 'embedding' for semantic similarity, 'exact' for exact question match
# Set to 'exact' if cached responses are not relevant to user's questions
CACHE_STRATEGY=embedding

# Minimum similarity score for embedding cache (0.0 to 1.0)
# Lower values = more lenient matching, Higher values = stricter matching
CACHE_SIMILARITY_THRESHOLD=0.85

# Cache TTL in seconds (default: 24 hours)
CACHE_TTL=86400